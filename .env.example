# Gmail SMTP defaults are already configured in app/api/contact/route.js.
# Only the Gmail app password is required to enable delivery.
SMTP_PASS=your-gmail-app-password

# Optional overrides for a different SMTP provider or recipient.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tomriddle2677@gmail.com
# CONTACT_FROM_EMAIL=tomriddle2677@gmail.com
# CONTACT_TO_EMAIL=tomriddle2677@gmail.com
